---
import Layout from '../layouts/Layout.astro';
import MembershipStatus from '../components/MembershipStatus.astro';
---
<Layout title="Membership — MegaMaker" description="MegaMaker is not accepting new members at this time. Learn about the community or get in touch.">
  <section class="utility-page shell">
    <p class="eyebrow">MegaMaker membership</p>
    <h1>A note about joining</h1>
    <MembershipStatus />
    <p>This is a pause in new memberships, not the end of our existing Slack community.</p>
    <p>Questions? <a href="mailto:words@megamaker.co">words@megamaker.co</a></p>
    <a class="back-link" href="/">← Back to MegaMaker</a>
  </section>
</Layout>
